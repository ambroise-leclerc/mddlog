@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The package states the toolchain it was built and qualified with, and refuses a consumer setup it
# cannot serve with an actionable message rather than a failure deep inside module scanning. It
# never changes the consumer's directory-wide flags, standard or variables (#121): the consumer
# selects C++23, `import std` and its own warnings; mddlog's targets carry their usage requirements.
# See docs/adr/ADR-007-compatibility-and-distribution.md and docs/consumer-requirements.md.
set(mddlog_BUILD_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(mddlog_BUILD_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(mddlog_BUILD_CMAKE_VERSION "@CMAKE_VERSION@")
set(mddlog_BUILD_INFO_FILE "${CMAKE_CURRENT_LIST_DIR}/mddlog-build-info.json")
set(mddlog_FILE_STORAGE @MDDLOG_BUILD_FILE_STORAGE@)
set(mddlog_AUDIT_TOOL @MDDLOG_BUILD_AUDIT_TOOLS@)

# Joins its arguments into the refusal message and stops reading this file.
macro(_mddlog_refuse)
    set(mddlog_FOUND FALSE)
    string(CONCAT mddlog_NOT_FOUND_MESSAGE ${ARGV})
    return()
endmacro()

if(CMAKE_VERSION VERSION_GREATER_EQUAL "4.4")
    _mddlog_refuse(
        "mddlog has not qualified CMake ${CMAKE_VERSION}'s import std gate; use a 4.0-4.3 release.")
endif()
if(NOT CMAKE_CXX_COMPILER_LOADED)
    _mddlog_refuse(
        "mddlog provides C++23 modules: enable the CXX language (project(... LANGUAGES CXX)) "
        "before find_package(mddlog).")
endif()
if(NOT CMAKE_GENERATOR MATCHES "Ninja")
    _mddlog_refuse(
        "mddlog's installed C++ modules need a Ninja generator; CMake selected "
        "\"${CMAKE_GENERATOR}\". Configure the consumer with -G Ninja.")
endif()
# A consumer rebuilds mddlog's BMIs and links its objects: only the compiler mddlog was built with
# is a qualified combination. MDDLOG_ACCEPT_UNQUALIFIED_TOOLCHAIN lets an integrator proceed, with a
# warning, for an evaluation that remains outside the qualified matrix.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL mddlog_BUILD_CXX_COMPILER_ID OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL mddlog_BUILD_CXX_COMPILER_VERSION)
    string(CONCAT _mddlog_toolchain_message
        "mddlog was built with ${mddlog_BUILD_CXX_COMPILER_ID} ${mddlog_BUILD_CXX_COMPILER_VERSION}; "
        "this consumer uses ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}. Neither BMIs nor "
        "objects are promised compatible across compilers: build mddlog from source with the "
        "consumer's toolchain.")
    if(MDDLOG_ACCEPT_UNQUALIFIED_TOOLCHAIN)
        message(WARNING "${_mddlog_toolchain_message} Proceeding because "
            "MDDLOG_ACCEPT_UNQUALIFIED_TOOLCHAIN is set; this combination is unqualified.")
    else()
        _mddlog_refuse("${_mddlog_toolchain_message} Set MDDLOG_ACCEPT_UNQUALIFIED_TOOLCHAIN=ON "
            "only for an explicitly unqualified evaluation.")
    endif()
    unset(_mddlog_toolchain_message)
endif()

if(NOT 23 IN_LIST CMAKE_CXX_COMPILER_IMPORT_STD AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    _mddlog_refuse(
        "mddlog's modules import std, but this consumer's toolchain does not offer C++23 import std "
        "(CMAKE_CXX_COMPILER_IMPORT_STD='${CMAKE_CXX_COMPILER_IMPORT_STD}'). Set "
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD to the gate of CMake ${CMAKE_VERSION} before project(), "
        "and select the standard library mddlog was built with.")
endif()

find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/mddlogTargets.cmake")

# Components: core (mddlog::core, governed only), full (mddlog::mddlog), file_storage (the Linux file
# adapters inside mddlog::mddlog) and audit_tool (the mddlog::audit_tool executable). The last two
# exist only when the installed build enabled them.
set(mddlog_core_FOUND TRUE)
set(mddlog_full_FOUND TRUE)
set(mddlog_file_storage_FOUND ${mddlog_FILE_STORAGE})
set(mddlog_audit_tool_FOUND ${mddlog_AUDIT_TOOL})
foreach(_mddlog_component IN LISTS mddlog_FIND_COMPONENTS)
    if(NOT _mddlog_component MATCHES "^(core|full|file_storage|audit_tool)$")
        set(mddlog_${_mddlog_component}_FOUND FALSE)
        set(mddlog_NOT_FOUND_MESSAGE
            "Unknown mddlog component '${_mddlog_component}'; known: core, full, file_storage, audit_tool.")
    elseif(NOT mddlog_${_mddlog_component}_FOUND AND mddlog_FIND_REQUIRED_${_mddlog_component})
        set(mddlog_NOT_FOUND_MESSAGE
            "mddlog component '${_mddlog_component}' was not enabled when this package was built.")
    endif()
endforeach()
unset(_mddlog_component)

check_required_components(mddlog)
