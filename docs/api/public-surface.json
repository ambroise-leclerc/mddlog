    "segment-layout": {
      "file": "include/mddlog/adapter/AuditLayout.cppm",
      "pattern": "storageLayoutVersion = (\\d+);",
      "version": 1
    },
    "anchor-claim": {
      "file": "include/mddlog/adapter/AuditAnchor.cppm",
      "pattern": "anchorFormatVersion = (\\d+);",
      "version": 1
    },
    "witness-protocol": {
      "file": "include/mddlog/adapter/WitnessCodec.cppm",
      "pattern": "protocolVersion = (\\d+);",
      "version": 1
    },
    "retained-position": {
      "file": "include/mddlog/adapter/FileRetainedPosition.cppm",
      "pattern": "formatVersion += (\\d+);",
      "version": 1
    },
    "evidence-package": {
      "file": "include/mddlog/adapter/AuditEvidence.cppm",
      "pattern": "auditEvidenceVersion = (\\d+);",
      "version": 1
    },
    "projection-json": {
      "file": "include/mddlog/adapter/AuditProjection.cppm",
      "pattern": "auditProjectionVersion = (\\d+);",
      "version": 1
    },
    "cli-configuration": {
      "file": "tools/AuditTool.cpp",
      "pattern": "value != \"(\\d+)\"\\)",
      "version": 1
    },
    "build-info": {
      "file": "cmake/MddlogBuildInfo.cmake",
      "pattern": "formatVersion (\\d+)\\)",
      "version": 1
    },
    "source-manifest": {
      "file": "scripts/package-source.py",
      "pattern": "'formatVersion': (\\d+),",
      "version": 1
    }
  },
