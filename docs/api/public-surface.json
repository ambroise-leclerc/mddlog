{
  "formatVersion": 1,
  "status": "candidate",
  "policy": "docs/adr/ADR-007-compatibility-and-distribution.md",
  "tiers": {
    "stable-candidate": "Usual-use surface proposed for the 1.0 source/behavior promise; frozen only after #122.",
    "extension": "Supported building blocks and interfaces an integrator implements or composes; same promise once frozen, and adding a pure virtual member needs a major version.",
    "format-codec": "C++ codecs of versioned byte formats. The formats are governed by their own versions; the C++ API may change in a minor release with a changelog entry.",
    "implementation-module": "Module import name not promised; its exported symbols are supported only through the umbrella names listed below.",
    "reduction-candidate": "Exported low-level helper kept for compatibility; to be reviewed for removal from the umbrella, with deprecation, before the freeze.",
    "test-double": "In-memory reference implementation for tests and evaluation, never a deployment backend.",
    "link-only": "Installed only because an exported target links it; not for direct use."
  },
  "targets": {
    "mddlog::core": {
      "component": "core",
      "tier": "stable-candidate",
      "kind": "static library",
      "note": "Governed modules only; links Threads through mddlog::mddlog_options."
    },
    "mddlog::mddlog": {
      "component": "full",
      "tier": "stable-candidate",
      "kind": "static library",
      "note": "Adapters, sinks, umbrella and facade; links mddlog::core PUBLIC."
    },
    "mddlog::audit_tool": {
      "component": "audit_tool",
      "tier": "extension",
      "kind": "executable",
      "note": "Optional Linux CLI mddlog-audit (MDDLOG_BUILD_AUDIT_TOOLS)."
    },
    "mddlog::mddlog_options": {
      "component": "core",
      "tier": "link-only",
      "kind": "interface",
      "note": "Threads and sanitizer link options of an instrumented build."
    }
  },
  "components": {
    "core": {
      "option": null,
      "targets": [
        "mddlog::core"
      ]
    },
    "full": {
      "option": null,
      "targets": [
        "mddlog::mddlog"
      ]
    },
    "file_storage": {
      "option": "MDDLOG_BUILD_FILE_STORAGE",
      "targets": [
        "mddlog::mddlog"
      ],
      "platforms": [
        "Linux"
      ]
    },
    "audit_tool": {
      "option": "MDDLOG_BUILD_AUDIT_TOOLS",
      "targets": [
        "mddlog::audit_tool"
      ],
      "platforms": [
        "Linux"
      ],
      "requires": [
        "file_storage"
      ]
    }
  },
